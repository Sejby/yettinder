{% extends 'base.html.twig' %}

{% block title %}Nový Yetti{% endblock %}

{% block body %}
<nav class="navbar navbar-light border-bottom bg-white">
    <div class="container">
        <a class="navbar-brand fw-bold" href="{{ path('app_home') }}">🏔️ Yettinder</a>
        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_stats') }}">Statistiky</a>
    </div>
</nav>

<div class="container py-5">
    <div class="row g-4">

        <div class="col-md-5">
            <h1 class="h3 mb-1">Přidat nového Yettiho</h1>
            <p class="text-muted mb-4">Vyplň základní informace.</p>

            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}

            {% if errors is not empty %}
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        {% for error in errors %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <form method="post" novalidate>
                <input type="hidden" name="_token" value="{{ csrf_token('create_yetti') }}">

                <div class="mb-3">
                    <label class="form-label fw-semibold">Jméno</label>
                    <input class="form-control" type="text" name="name" maxlength="100" required value="{{ form.name }}">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Pohlaví</label>
                    <select class="form-select" name="gender" required>
                        <option value="">Vyber...</option>
                        <option value="male" {{ form.gender == 'male' ? 'selected' : '' }}>Muž</option>
                        <option value="female" {{ form.gender == 'female' ? 'selected' : '' }}>Žena</option>
                        <option value="other" {{ form.gender == 'other' ? 'selected' : '' }}>Jiné</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Výška (cm)</label>
                    <input class="form-control" type="number" name="height" min="50" max="350" step="1" required value="{{ form.height }}">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Váha (kg)</label>
                    <input class="form-control" type="number" name="weight" min="10" max="500" step="0.1" required value="{{ form.weight }}">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Bydliště</label>
                    <input class="form-control" type="text" name="address" maxlength="120" required value="{{ form.address }}">
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Hodnocení (0–5)</label>
                    <input class="form-control" type="number" name="rating" min="0" max="5" step="0.1" required value="{{ form.rating }}">
                </div>

                <button class="btn btn-dark" type="submit">Uložit Yettiho</button>
            </form>
        </div>

        <div class="col-md-7">
            <h2 class="h5 mb-3">Poslední Yetti</h2>
            {% if yettis is empty %}
                <p class="text-muted">Zatím žádný Yetti.</p>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Jméno</th>
                                <th>Pohlaví</th>
                                <th>Výška</th>
                                <th>Váha</th>
                                <th>Bydliště</th>
                                <th>Hodnocení</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for yetti in yettis %}
                                <tr>
                                    <td>{{ yetti.name }}</td>
                                    <td>{{ yetti.gender }}</td>
                                    <td>{{ yetti.height }} cm</td>
                                    <td>{{ yetti.weight }} kg</td>
                                    <td>{{ yetti.address }}</td>
                                    <td>{{ yetti.rating }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>

    </div>
</div>
{% endblock %}
