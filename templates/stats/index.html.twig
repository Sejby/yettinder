{% extends 'base.html.twig' %}

{% block title %}Statistiky | Yettinder{% endblock %}

{% block body %}
    <nav class="navbar navbar-light border-bottom bg-white">
        <div class="container">
            <a class="navbar-brand fw-bold" href="{{ path('app_home') }}">🏔️ Yettinder</a>
            <div class="d-flex gap-2">
                <a class="btn btn-sm btn-dark" href="{{ path('app_match') }}">Najít match</a>
                <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_yetti_new') }}">+ Přidat Yetiho</a>
            </div>
        </div>
    </nav>

    <div class="container py-5">

        <h1 class="h3 mb-4">Statistiky hlasování</h1>

        <div class="mb-5">
            <h2 class="h5 mb-3">Hlasy za posledních 30 dní</h2>
            {{ render_chart(chart, {'height': '80'}) }}
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <h2 class="h5 mb-3">Podle roku</h2>
                {% if byYear is empty %}
                    <p class="text-muted">Zatím žádné hlasy.</p>
                {% else %}
                    <table class="table table-sm">
                        <thead class="table-light">
                        <tr>
                            <th>Rok</th>
                            <th>👍</th>
                            <th>👎</th>
                            <th>Skóre</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for row in byYear %}
                            <tr>
                                <td>{{ row.period }}</td>
                                <td>{{ row.positive }}</td>
                                <td>{{ row.negative }}</td>
                                <td>{% if row.score > 0 %}+{% endif %}{{ row.score }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>

            <div class="col-md-4">
                <h2 class="h5 mb-3">Podle měsíce</h2>
                {% if byMonth is empty %}
                    <p class="text-muted">Zatím žádné hlasy.</p>
                {% else %}
                    <div style="max-height: 340px; overflow-y: auto">
                        <table class="table table-sm">
                            <thead class="table-light sticky-top">
                            <tr>
                                <th>Měsíc</th>
                                <th>👍</th>
                                <th>👎</th>
                                <th>Skóre</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for row in byMonth %}
                                <tr>
                                    <td>{{ row.period }}</td>
                                    <td>{{ row.positive }}</td>
                                    <td>{{ row.negative }}</td>
                                    <td>{% if row.score > 0 %}+{% endif %}{{ row.score }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>

            <div class="col-md-4">
                <h2 class="h5 mb-3">Žebříček Yetiů</h2>
                {% if top is empty %}
                    <p class="text-muted">Zatím žádní Yetti.</p>
                {% else %}
                    <table class="table table-sm">
                        <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Jméno</th>
                            <th>Hlasů</th>
                            <th>Skóre</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for yetti in top %}
                            <tr>
                                <td class="text-muted">{{ loop.index }}</td>
                                <td>
                                    {{ yetti.name }}<br>
                                    <small class="text-muted">{{ yetti.address }}</small>
                                </td>
                                <td>{{ yetti.voteCount }}</td>
                                <td>{% if yetti.score > 0 %}+{% endif %}{{ yetti.score }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>

        </div>

    </div>
{% endblock %}
